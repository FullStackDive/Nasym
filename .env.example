# =============================================================================
# Database (Neon Postgres — free tier)
# Get from https://console.neon.tech → project → Connection Details
# DATABASE_URL is the pooled connection (used by app at runtime).
# DATABASE_URL_UNPOOLED is the direct connection (used by `prisma migrate`).
# =============================================================================
DATABASE_URL="postgres://USER:PASS@HOST-pooler.region.aws.neon.tech/DBNAME?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://USER:PASS@HOST.region.aws.neon.tech/DBNAME?sslmode=require"

# =============================================================================
# NextAuth
# Generate secret with: openssl rand -base64 32
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-secret"

# =============================================================================
# Vercel Blob (free tier file storage)
# Auto-injected on Vercel when a Blob store is connected to the project.
# For local dev: Vercel project → Storage → Blob → .env.local
# Without this token, uploads fall back to local disk (dev only).
# =============================================================================
BLOB_READ_WRITE_TOKEN=""

# =============================================================================
# Jitsi (default uses public meet.jit.si)
# =============================================================================
NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# =============================================================================
# Email (SMTP) — leave SMTP_USER/SMTP_PASS blank to use Ethereal test in dev.
# Free options for prod:
#   - Resend (https://resend.com): 3000/mo free; SMTP host smtp.resend.com
#   - Brevo (https://brevo.com): 300/day free; SMTP host smtp-relay.brevo.com
# =============================================================================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nasym <no-reply@nasym.local>"
