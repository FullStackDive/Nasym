# =============================================================================
# Database (Postgres, Railway/Neon)
# =============================================================================
DATABASE_URL="postgres://USER:PASS@HOST/DBNAME"
DATABASE_URL_UNPOOLED="postgres://USER:PASS@HOST/DBNAME"

# =============================================================================
# NextAuth
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-secret"

# =============================================================================
# Google OAuth (optional)
# =============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# Jitsi
# =============================================================================
NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# =============================================================================
# Production transactional email — recommended for Railway on ALL plans.
# Resend API uses HTTPS rather than SMTP (blocked on Railway Free/Hobby/Trial).
#
# 1. Verify the nasymurrahmah.com sending domain in https://resend.com/domains
# 2. Generate a sending API key in https://resend.com/api-keys
# 3. Add the actual RESEND_API_KEY securely to Railway's Nasym service variables.
# 4. Keep RESEND_FROM_EMAIL at a sender address on that verified domain.
# Never put real credentials in .env.example or GitHub.
# =============================================================================
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Nasym-Ur-Rahmah Institute <no-reply@nasymurrahmah.com>"

# =============================================================================
# Legacy SMTP (only available on Railway Pro or for development).
# Leave SMTP_USER/SMTP_PASS empty when using Resend.
# =============================================================================
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Nasym-Ur-Rahmah Institute <no-reply@nasymurrahmah.com>"

# =============================================================================
# Optional file storage
# =============================================================================
BLOB_READ_WRITE_TOKEN=""
